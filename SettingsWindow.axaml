<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WhiteMC.SettingsWindow"
        Title="WhiteMC — настройки" Width="840" Height="460"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        CanResize="False"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent"
              PointerPressed="TitleBar_PointerPressed">
            <TextBlock Text="WhiteMC — настройки"
                       VerticalAlignment="Center" Margin="20,0,0,0"
                       Foreground="{DynamicResource Subtext}" FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Content="−" Classes="titlebar" Click="BtnMinimize_Click"/>
                <Button Content="✕" Classes="titlebar-close"
                        Margin="4,0,0,0" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,4,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Настройки" Classes="h2"/>
            <Rectangle Grid.Row="1" Height="1"
                       Fill="{DynamicResource Border}" Margin="0,12,0,14"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ник" FontWeight="Bold"
                           Foreground="{DynamicResource Subtext}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            Margin="14,0,0,10">
                    <TextBox x:Name="TxtUser" Width="260" HorizontalAlignment="Left"/>
                    <TextBlock Classes="subtext" VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Text="Прогресс в игре привязывается к нику"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Память" FontWeight="Bold"
                           Foreground="{DynamicResource Subtext}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                            Margin="14,0,0,10">
                    <TextBlock Text="Xms" Classes="subtext" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtXms" Width="80" Margin="6,0,16,0"/>
                    <TextBlock Text="Xmx" Classes="subtext" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtXmx" Width="80" Margin="6,0,8,0"/>
                    <Button Content="Авто" Classes="ghost"
                            Click="BtnAutoMemory_Click"/>
                    <TextBlock x:Name="LblRamHint" Classes="subtext"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="JVM-аргументы" FontWeight="Bold"
                           Foreground="{DynamicResource Subtext}" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtJvm" Grid.Row="2" Grid.Column="1" Margin="14,0,0,10"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Тема" FontWeight="Bold"
                           Foreground="{DynamicResource Subtext}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"
                            Margin="14,0,0,10">
                    <ComboBox x:Name="CmbTheme" Width="240"
                              SelectionChanged="CmbTheme_SelectionChanged"/>
                    <TextBlock Classes="subtext"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="Применяется сразу"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                           x:Name="LblLogPath" Classes="subtext"
                           Margin="0,14,0,0"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Предыдущий: latest.prev.log"
                           Classes="subtext"
                           Margin="0,2,0,0"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                           x:Name="LblCache" Classes="subtext"
                           Margin="0,2,0,0"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                           Classes="subtext" Margin="0,2,0,0"
                           Text="Опциональные моды переключаются кнопкой «🧩 Опциональные моды» в главном окне."/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnOpenLauncher" Content="📂  Папка лаунчера"
                            Classes="ghost"/>
                    <Button x:Name="BtnOpenInstance" Content="📂  Папка инстанса"
                            Classes="ghost" Margin="6,0,0,0"/>
                    <Button x:Name="BtnOpenLogs" Content="📜  Логи"
                            Classes="ghost" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Classes="base"
                            Margin="0,0,8,0" Click="BtnCancel_Click"/>
                    <Button Content="Сохранить" Classes="primary"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
