<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WhiteMC.MainWindow"
        Title="WhiteMC" Width="760" Height="500"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="False"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">
    <Grid Margin="24,20,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent"
              PointerPressed="TitleBar_PointerPressed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="WhiteMC" Classes="h1"/>
                <TextBlock Text="лаунчер Minecraft" Classes="subtext"
                           VerticalAlignment="Bottom" Margin="10,0,0,4"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button x:Name="BtnSettings" Content="⚙  Настройки"
                        Classes="ghost" Click="BtnSettings_Click"/>
                <Button x:Name="BtnLogs" Content="📜  Логи"
                        Classes="ghost" Margin="6,0,0,0"
                        Click="BtnLogs_Click"/>
                <Button x:Name="BtnMinimize" Content="−"
                        Classes="titlebar" Margin="14,0,0,0"
                        Click="BtnMinimize_Click"/>
                <Button x:Name="BtnClose" Content="✕"
                        Classes="titlebar-close" Margin="4,0,0,0"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource Border}" Margin="0,16,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,16">
            <TextBlock Text="Профиль" Classes="h2" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbProfile" Width="260" Margin="14,0,12,0"
                      SelectionChanged="CmbProfile_SelectionChanged"/>
            <TextBlock x:Name="LblVersion" Foreground="{DynamicResource Accent}"
                       FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="3" Background="{DynamicResource Card}"
                CornerRadius="8" Padding="20,16"
                Margin="0,0,0,18">
            <StackPanel>
                <TextBlock x:Name="LblDesc" TextWrapping="Wrap"
                           Margin="0,0,0,8" IsVisible="False"/>
                <TextBlock x:Name="LblJava"/>
                <TextBlock x:Name="LblNeoForge" Margin="0,6,0,0"/>
                <TextBlock x:Name="LblModpack"   Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="LblMods"      Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="LblInstance"  Classes="subtext"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,18">
            <Button x:Name="BtnInstall" Content="⬇  Установить" Classes="primary"/>
            <Button x:Name="BtnNeoForge" Content="➕  Установить NeoForge"
                    Classes="primary" Margin="8,0,0,0" IsVisible="False"
                    Click="BtnNeoForge_Click"/>
            <Button x:Name="BtnUpdate"  Content="🔄  Проверить обновления"
                    Classes="base" Margin="8,0,0,0" IsVisible="False"/>
            <Button x:Name="BtnOptional" Content="🧩  Опциональные моды"
                    Classes="base" Margin="8,0,0,0" IsVisible="False"
                    Click="BtnOptional_Click"/>
            <Button x:Name="BtnRepair"  Content="🛠  Починить установку"
                    Classes="base" Margin="8,0,0,0" IsVisible="False"/>
            <Button x:Name="BtnLaunch"  Content="▶  Запустить" Classes="success"
                    Margin="8,0,0,0" IsVisible="False"/>
            <Button x:Name="BtnKill"    Content="⛔  Завершить" Classes="danger"
                    Margin="8,0,0,0" IsVisible="False"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,10">
            <TextBlock x:Name="LblStatus" Classes="subtext"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ProgressBar x:Name="Prog" VerticalAlignment="Top"
                         Minimum="0" Maximum="100" Value="0" IsVisible="False"/>
        </StackPanel>

        <Grid Grid.Row="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="📄" Classes="subtext"/>
                <TextBlock x:Name="LblLogFile" Classes="subtext" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="LblAppVersion" Classes="subtext"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
