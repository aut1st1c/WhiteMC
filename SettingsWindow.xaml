<Window x:Class="WhiteMC.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhiteMC — настройки" Width="840" Height="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="Transparent"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="WhiteMC — настройки"
                       VerticalAlignment="Center" Margin="20,0,0,0"
                       Foreground="{StaticResource Subtext}" FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Content="−" Style="{StaticResource TitleBarBtn}"
                        Click="BtnMinimize_Click"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseBtn}"
                        Margin="4,0,0,0" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20,4,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Настройки" Style="{StaticResource H2}"/>
            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource Border}" Margin="0,12,0,14"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ник" FontWeight="Bold"
                           Foreground="{StaticResource Subtext}" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtUser" Grid.Row="0" Grid.Column="1" Margin="14,0,0,10" Width="260"
                         HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Память" FontWeight="Bold"
                           Foreground="{StaticResource Subtext}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                            Margin="14,0,0,10">
                    <TextBlock Text="Xms" Style="{StaticResource SubtextStyle}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtXms" Width="80" Margin="6,0,16,0"/>
                    <TextBlock Text="Xmx" Style="{StaticResource SubtextStyle}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtXmx" Width="80" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="JVM-аргументы" FontWeight="Bold"
                           Foreground="{StaticResource Subtext}" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtJvm" Grid.Row="2" Grid.Column="1" Margin="14,0,0,10"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                           x:Name="LblLogPath" Style="{StaticResource SubtextStyle}" Margin="0,14,0,0"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Предыдущий: latest.prev.log" Style="{StaticResource SubtextStyle}"
                           Margin="0,2,0,0"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                           x:Name="LblCache" Style="{StaticResource SubtextStyle}" Margin="0,2,0,0"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnOpenLauncher" Content="📂  Папка лаунчера"
                            Style="{StaticResource GhostBtn}"/>
                    <Button x:Name="BtnOpenInstance" Content="📂  Папка инстанса"
                            Style="{StaticResource GhostBtn}" Margin="6,0,0,0"/>
                    <Button x:Name="BtnOpenLogs" Content="📜  Логи"
                            Style="{StaticResource GhostBtn}" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Style="{StaticResource BaseBtn}"
                            Margin="0,0,8,0" Click="BtnCancel_Click"/>
                    <Button Content="Сохранить" Style="{StaticResource PrimaryBtn}"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>