<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WhiteMC.LogsWindow"
        Title="WhiteMC — логи" Width="980" Height="580"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        CanResize="False"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent"
              PointerPressed="TitleBar_PointerPressed">
            <TextBlock Text="WhiteMC — логи"
                       VerticalAlignment="Center" Margin="20,0,0,0"
                       Foreground="{DynamicResource Subtext}" FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Content="−" Classes="titlebar" Click="BtnMinimize_Click"/>
                <Button Content="✕" Classes="titlebar-close"
                        Margin="4,0,0,0" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="16,4,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Журнал лаунчера" Classes="h2"/>
                <TextBlock x:Name="LblPath" Classes="subtext"
                           VerticalAlignment="Center" Margin="12,2,0,0"/>
            </StackPanel>

            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource Border}"
                       Margin="0,10,0,12"/>

            <Border Grid.Row="2" Background="{DynamicResource Mantle}" CornerRadius="6">
                <TextBox x:Name="TxtLog" IsReadOnly="True"
                         Background="Transparent" Foreground="{DynamicResource Text}"
                         BorderThickness="0" Padding="12,10"
                         FontFamily="{DynamicResource MonoFont}" FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"/>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="📂  Открыть папку с логами" Classes="ghost"
                            Click="BtnOpenFolder_Click"/>
                    <Button Content="Очистить вид" Classes="ghost" Margin="6,0,0,0"
                            Click="BtnClear_Click"/>
                </StackPanel>
                <Button Content="Закрыть" Classes="base"
                        HorizontalAlignment="Right" Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>